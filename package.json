{
  "name": "hawt-ecommerce",
  "version": "1.0.0",
  "description": "Hawt — streetwear e-commerce",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "db:migrate": "node db/migrate.js up",
    "db:rollback": "node db/migrate.js down",
    "db:seed": "node db/seed.js",
    "db:migrate:create": "node-pg-migrate -m db/migrations create"
  },
  "node-pg-migrate": {
    "migrationsTable": "pgmigrations",
    "dir": "db/migrations"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-pg-migrate": "^6.2.2",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3"
  }
}
